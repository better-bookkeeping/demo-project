generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  password     String
  calorieGoal  Int?
  workouts     Workout[]
  weights      UserWeight[]
  nutritionLogs NutritionLog[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model UserWeight {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  weight     Float
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt(sort: Desc)])
}

model Movement {
  id         String  @id @default(uuid())
  name       String
  bodyWeight Boolean @default(false)
  sets       Set[]
}

model Workout {
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  id          String    @id @default(uuid())
  completedAt DateTime?
  sets        Set[]

  @@index([userId, completedAt])
}

model Set {
  id         String   @id @default(uuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  movementId String
  movement   Movement @relation(fields: [movementId], references: [id])
  reps       Int
  weight     Int

  @@index([workoutId])
  @@index([movementId])
}

model NutritionLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  calories Int
  carbsG   Float
  proteinG Float
  fatG     Float
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt(sort: Desc)])
}
