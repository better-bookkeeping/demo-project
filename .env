# Local development defaults. These are not secrets and are safe to commit.
# Override any value in a gitignored .env.local file.

VITE_ENVIRONMENT=development
ENVIRONMENT=development
COOKIE_SECRET=local-development-cookie-secret

# Postgres runs in Docker and is published on a non-default host port so it
# doesn't collide with a Postgres you may already have running on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/setlist
